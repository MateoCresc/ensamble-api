# Pedidos de verificación manual (extensión REST Client de VS Code).
@baseUrl = http://localhost:3000

### Estado del servicio → 200 { status: "ok", persistence }
GET {{baseUrl}}/health

### Ruta inexistente → 404 NOT_FOUND
GET {{baseUrl}}/no-existe

### JSON mal formado → 400 INVALID_JSON
POST {{baseUrl}}/health
Content-Type: application/json

{ "nombre":

### Especificación OpenAPI → 200 JSON con openapi 3.x
GET {{baseUrl}}/api-docs.json

### Swagger UI → 200 HTML
GET {{baseUrl}}/api-docs/

# ─── Clientes ──────────────────────────────────────────────────────────────

### Crear cliente → 201 + Location
POST {{baseUrl}}/clientes
Content-Type: application/json

{ "nombre": "Ana Pérez", "email": "ana@mail.com", "telefono": "1155550000" }

### Crear otro cliente (email en mayúsculas → se guarda en minúsculas) → 201
POST {{baseUrl}}/clientes
Content-Type: application/json

{ "nombre": "Mariana Gómez", "email": "MARIANA@mail.com" }

### Email repetido → 409 EMAIL_DUPLICADO
POST {{baseUrl}}/clientes
Content-Type: application/json

{ "nombre": "Otra Ana", "email": "ANA@mail.com" }

### Datos inválidos → 400 VALIDATION_ERROR (un detalle por campo)
POST {{baseUrl}}/clientes
Content-Type: application/json

{ "email": "no-es-un-email" }

### Listar todos → 200
GET {{baseUrl}}/clientes

### Filtrar por nombre parcial, ordenar Z→A y paginar → 200
GET {{baseUrl}}/clientes?nombre=ana&sort=-nombre&page=1&limit=10

### Orden no permitido → 400 VALIDATION_ERROR
GET {{baseUrl}}/clientes?sort=telefono

### Obtener por id → 200
GET {{baseUrl}}/clientes/1

### Obtener inexistente → 404 CLIENTE_NO_ENCONTRADO
GET {{baseUrl}}/clientes/999

### Id inválido → 400 VALIDATION_ERROR
GET {{baseUrl}}/clientes/abc

### Actualizar parcialmente → 200
PUT {{baseUrl}}/clientes/1
Content-Type: application/json

{ "telefono": "1166660000" }

### Actualizar con el email de otro cliente → 409 EMAIL_DUPLICADO
PUT {{baseUrl}}/clientes/2
Content-Type: application/json

{ "email": "ana@mail.com" }

### Actualizar sin campos → 400 VALIDATION_ERROR
PUT {{baseUrl}}/clientes/1
Content-Type: application/json

{}

### Eliminar → 204
DELETE {{baseUrl}}/clientes/2

### Eliminar inexistente → 404 CLIENTE_NO_ENCONTRADO
DELETE {{baseUrl}}/clientes/999

# ─── Materiales ────────────────────────────────────────────────────────────

### Crear material → 201 + Location
POST {{baseUrl}}/materiales
Content-Type: application/json

{ "nombre": "Tablón de pino", "unidad": "m", "stock": 12.5, "stockMinimo": 3 }

### Crear material con valores por defecto (stock 0) → 201
POST {{baseUrl}}/materiales
Content-Type: application/json

{ "nombre": "Clavos", "unidad": "kg" }

### Nombre repetido (mayúsculas y espacios) → 409 MATERIAL_DUPLICADO
POST {{baseUrl}}/materiales
Content-Type: application/json

{ "nombre": " TABLÓN DE PINO ", "unidad": "m" }

### Unidad inválida y stock con 3 decimales → 400 VALIDATION_ERROR
POST {{baseUrl}}/materiales
Content-Type: application/json

{ "nombre": "Lija", "unidad": "caja", "stock": 1.005 }

### Materiales con bajo stock → 200
GET {{baseUrl}}/materiales?bajoStock=true

### Ordenar por stock descendente → 200
GET {{baseUrl}}/materiales?sort=-stock

### Obtener material → 200
GET {{baseUrl}}/materiales/1

### Reponer stock → 200
PUT {{baseUrl}}/materiales/2
Content-Type: application/json

{ "stock": 25 }

### Eliminar material → 204
DELETE {{baseUrl}}/materiales/2

# ─── Encargos: recorrido completo ──────────────────────────────────────────
# Requiere el cliente 1 y los materiales 1 (Tablón de pino) y 3 (Clavos) de los pedidos anteriores.

### Crear encargo presupuestado con materiales → 201
POST {{baseUrl}}/encargos
Content-Type: application/json

{ "clienteId": 1, "descripcion": "Mesa de comedor", "fechaEntregaEstimada": "2026-12-20", "materiales": [{ "materialId": 1, "cantidad": 10 }] }

### Encargo con un material inexistente → 404 MATERIAL_NO_ENCONTRADO
POST {{baseUrl}}/encargos
Content-Type: application/json

{ "clienteId": 1, "descripcion": "Banco", "materiales": [{ "materialId": 99, "cantidad": 1 }] }

### Encargos del cliente 1 → 200
GET {{baseUrl}}/encargos?clienteId=1

### Reemplazar materiales mientras está presupuestado → 200
PUT {{baseUrl}}/encargos/1
Content-Type: application/json

{ "materiales": [{ "materialId": 1, "cantidad": 10 }, { "materialId": 3, "cantidad": 0.5 }] }

### Confirmar: descuenta stock (y avisa stock bajo del tablón) → 200
PUT {{baseUrl}}/encargos/1/confirmar

### Ver el stock descontado → 200
GET {{baseUrl}}/materiales?bajoStock=true

### Confirmar de nuevo → 409 TRANSICION_INVALIDA
PUT {{baseUrl}}/encargos/1/confirmar

### Editar un encargo confirmado → 409 ENCARGO_NO_EDITABLE
PUT {{baseUrl}}/encargos/1
Content-Type: application/json

{ "descripcion": "Otra cosa" }

### Borrar el cliente con encargos → 409 CLIENTE_CON_ENCARGOS
DELETE {{baseUrl}}/clientes/1

### Borrar un material usado → 409 MATERIAL_EN_USO
DELETE {{baseUrl}}/materiales/1

### Cancelar el confirmado: repone stock → 200
PUT {{baseUrl}}/encargos/1/cancelar

### Encargo que pide más de lo que hay → confirmar da 409 STOCK_INSUFICIENTE
POST {{baseUrl}}/encargos
Content-Type: application/json

{ "clienteId": 1, "descripcion": "Galpón", "materiales": [{ "materialId": 1, "cantidad": 999 }] }

###
PUT {{baseUrl}}/encargos/2/confirmar

### Recorrido de producción: crear, confirmar, iniciar y entregar
POST {{baseUrl}}/encargos
Content-Type: application/json

{ "clienteId": 1, "descripcion": "Estante", "materiales": [{ "materialId": 3, "cantidad": 0.25 }] }

###
PUT {{baseUrl}}/encargos/3/confirmar

###
PUT {{baseUrl}}/encargos/3/iniciar

###
PUT {{baseUrl}}/encargos/3/entregar
