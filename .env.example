# Puerto HTTP donde escucha la API
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=development

# Tipo de persistencia: memory | sequelize
PERSISTENCE_TYPE=memory

# Archivo de la base SQLite (solo con PERSISTENCE_TYPE=sequelize). Ignorado por git (*.sqlite).
# Si cambia el esquema durante el desarrollo, borrá este archivo y se vuelve a crear al arrancar.
DB_STORAGE=./ensamble.sqlite

# Mostrar en consola el SQL que ejecuta Sequelize: true | false
DB_LOGGING=false

# Canal de cada aviso: console | file
# Aviso "Encargo confirmado" (evento encargo.confirmado)
NOTIFIER_ENCARGOS=console
# Aviso "Stock bajo" (evento material.stockBajo)
NOTIFIER_STOCK=file

# Archivo donde escribe el canal "file". Ignorado por git (*.log).
NOTIFICATIONS_FILE=./notificaciones.log
